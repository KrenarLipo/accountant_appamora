# Accountant by AppAmora — production settings for GoDaddy cPanel.
# The build script copies this to .env inside the release zip and adds a fresh APP_KEY.
# Fill in every value marked FILL-IN on the server (cPanel File Manager → edit .env).
# Never commit the filled-in file.

APP_NAME=Accountant
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://accountant.appamora.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=app_accountant
DB_USERNAME=app_accountant_user
DB_PASSWORD="FILL-IN-database-password"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=accountant.appamora.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Email (verification, password reset, alerts). Pick the block that matches your mailbox:
# GoDaddy shared hosting blocks SMTP to outside servers (Gmail etc.): use MAIL_MAILER=sendmail there.
#  cPanel email:              MAIL_HOST=mail.appamora.com      MAIL_PORT=465 MAIL_SCHEME=smtps
#  GoDaddy Professional Email: MAIL_HOST=smtpout.secureserver.net MAIL_PORT=465 MAIL_SCHEME=smtps
#  Microsoft 365 via GoDaddy:  MAIL_HOST=smtp.office365.com     MAIL_PORT=587 MAIL_SCHEME=smtp
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.appamora.com
MAIL_PORT=465
MAIL_USERNAME="FILL-IN-mailbox@appamora.com"
MAIL_PASSWORD="FILL-IN-mailbox-password"
MAIL_FROM_ADDRESS="FILL-IN-mailbox@appamora.com"
MAIL_FROM_NAME="Accountant by AppAmora"
# Replies to app emails go here (e.g. your own Gmail):
MAIL_REPLY_TO_ADDRESS=

# Optional: Claude explanations in alerts. Leave empty to use standard wording.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
